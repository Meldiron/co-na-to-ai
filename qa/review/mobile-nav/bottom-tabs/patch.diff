index 0000000..56d1644
--- /dev/null
+++ b/src/components/phone-tabs.tsx
@@ -0,0 +1,29 @@
+import { Link } from "@tanstack/react-router"
+
+const tabs = [
+  { to: "/", label: "Hra" },
+  { to: "/archiv", label: "Archiv" },
+  { to: "/obsazeni", label: "Obsazení" },
+] as const
+
+const tabClass = "relative flex h-16 flex-1 items-center justify-center font-semibold transition-colors"
+
+export function PhoneTabs() {
+  return (
+    <nav aria-label="Hlavní" className="tab-bar fixed inset-x-0 bottom-0 z-40 flex bg-board pb-[env(safe-area-inset-bottom)] text-flap-dim md:hidden">
+      {tabs.map((tab) => (
+        <Link key={tab.to} to={tab.to} activeOptions={{ exact: true }} className={`${tabClass} data-[status=active]:text-flap-ink`}>
+          {({ isActive }) => (
+            <>
+              {isActive && <span aria-hidden className="absolute inset-x-4 top-0 h-[3px] bg-red" />}
+              {tab.label}
+            </>
+          )}
+        </Link>
+      ))}
+      <a href="/#pravidla" className={`${tabClass} hover:text-flap-ink`}>
+        Pravidla
+      </a>
+    </nav>
+  )
+}
