+const weekday = new Intl.DateTimeFormat("cs-CZ", { weekday: "short", timeZone: "UTC" })
+
+function mondayOf(date: string): string {
+  const day = new Date(`${date}T12:00:00Z`).getUTCDay()
+  return addDays(date, -((day + 6) % 7))
+}
+
+function weekTitle(monday: string, today: string): string {
+  const current = mondayOf(today)
+  if (monday === current) return "Tento týden"
+  if (monday === addDays(current, -7)) return "Minulý týden"
+  return `${formatDayMonth(monday)} – ${formatDayMonth(addDays(monday, 6))}`
+}
+
+function groupByWeek(puzzles: Array<PuzzleSummary>): Array<[string, Array<PuzzleSummary>]> {
+  const weeks = new Map<string, Array<PuzzleSummary>>()
+  for (const puzzle of puzzles) {
+    const monday = mondayOf(puzzle.date)
+    weeks.set(monday, [...(weeks.get(monday) ?? []), puzzle])
+  }
+  return [...weeks.entries()]
+}
