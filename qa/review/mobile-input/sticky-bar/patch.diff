+
+@media (max-width: 767px) {
+  .input-bar {
+    position: fixed;
+    inset-inline: 0;
+    bottom: 0;
+    z-index: 40;
+    padding: 0.625rem var(--margin) calc(0.5rem + env(safe-area-inset-bottom));
+    background: var(--board);
+    color: var(--field-ink);
+  }
+  .input-bar .input-bar-row {
+    margin-top: 0;
+    gap: 0.5rem;
+  }
+  .input-bar .input-bar-row input,
+  .input-bar .input-bar-row button[type="submit"] {
+    height: 3rem;
+  }
+  .input-bar [role="img"] > span {
+    width: 2.25rem;
+    height: 2.25rem;
+  }
+  .input-bar .input-bar-row .flap {
+    height: 2.25rem;
+  }
+  .input-bar .input-bar-note {
+    margin-top: 0.375rem;
+    font-size: var(--step-small);
+    line-height: 1.35;
+  }
+  .input-bar .input-bar-note p {
+    min-height: 0;
+  }
+  body:has(.input-bar) {
+    padding-bottom: calc(9.5rem + env(safe-area-inset-bottom));
+  }
+}
