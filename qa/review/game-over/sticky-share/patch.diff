@@ -0,0 +1,53 @@
+import { useEffect, useState } from "react"
+import { Button } from "@/components/ui/button"
+import { pointsWord, shareText, type GameState } from "@/lib/game"
+import type { BoardAnswer, PuzzlePayload } from "@/lib/types"
+import { gameLabel } from "./game"
+import { shareOrCopy, sharePath } from "./results"
+
+type Props = { payload: PuzzlePayload; state: GameState; answers: Array<BoardAnswer>; total: number; daily: boolean }
+
+export function StickyShare({ payload, state, answers, total, daily }: Props) {
+  const [seen, setSeen] = useState(false)
+  const [copied, setCopied] = useState(false)
+
+  useEffect(() => {
+    const target = document.getElementById("vysledek")
+    if (!target) return
+    const io = new IntersectionObserver(
+      ([entry]) => {
+        if (entry.isIntersecting) setSeen(true)
+      },
+      { threshold: 0.15 },
+    )
+    io.observe(target)
+    return () => io.disconnect()
+  }, [])
+
+  async function share() {
+    const url = `${window.location.origin}${sharePath(payload, daily)}`
+    const outcome = await shareOrCopy(shareText({ label: gameLabel(payload), question: payload.question, state, answers, total, url }))
+    if (outcome === "copied") {
+      setCopied(true)
+      setTimeout(() => setCopied(false), 2400)
+    }
+    if (outcome === "failed") document.getElementById("vysledek")?.scrollIntoView({ behavior: "smooth" })
+  }
+
+  if (seen) return null
+  return (
+    <div className="fixed inset-x-0 bottom-0 z-40 bg-board pb-[env(safe-area-inset-bottom)] text-flap-ink animate-in slide-in-from-bottom-full duration-300 motion-reduce:animate-none">
+      <div className="page flex h-16 items-center justify-between gap-4 md:h-[4.5rem]">
+        <a href="#vysledek" className="flex min-w-0 items-baseline gap-2 hover:text-flap-dim">
+          <span className="head tabular-nums">{total}</span>
+          <span className="truncate">
+            {pointsWord(total)} · {state.found.length} z {answers.length}
+          </span>
+        </a>
+        <Button onClick={share} className="h-11 shrink-0 px-5 font-semibold">
+          {copied ? "Zkopírováno" : "Sdílet výsledek"}
+        </Button>
+      </div>
+    </div>
+  )
+}
