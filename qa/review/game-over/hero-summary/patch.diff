+export function sharePath(payload: PuzzlePayload, daily: boolean): string {
+  return payload.kind === "custom" ? `/vlastni/${payload.id}` : daily ? "/" : `/hra/${payload.date}`
+}
+
+export async function shareOrCopy(text: string): Promise<"shared" | "copied" | "cancelled" | "failed"> {
+  try {
+    if ("share" in navigator) {
+      await navigator.share({ text })
+      return "shared"
+    }
+  } catch (error) {
+    if (error instanceof DOMException && error.name === "AbortError") return "cancelled"
+  }
+  try {
+    await navigator.clipboard.writeText(text)
+    return "copied"
+  } catch {
+    return "failed"
+  }
+}
